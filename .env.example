# ─── ডাটাবেস (Prisma + SQLite; Vercel-এ লোকাল ফাইল স্বয়ংক্রিয়) ───
DATABASE_URL=file:./db/custom.db

# ─── NextAuth ───
# এটা ডাটাবেস নয় — সেশন-টোকেন (JWT/কুকি) সাইন+এনক্রিপ্ট করার ক্রিপ্টো-কী।
# জেনারেট করুন: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-in-production
NEXTAUTH_URL=http://localhost:3000

# ─── Turso (ঐচ্ছিক ক্লাউড ডাটাবেস) — সেট করলেই সব API এটার দিকে তাকায়,
# খালি থাকলে লোকাল SQLite (DATABASE_URL) চলে। দুটো একসাথেই কনফিগার করা যায়।
# সেটআপ: turso db create bwp
#        turso db show bwp --url          → TURSO_DATABASE_URL
#        turso db tokens create bwp       → TURSO_AUTH_TOKEN
# স্কিমা পুশ: DATABASE_URL ছাড়া পুশ করা যায় না — প্রথমে লোকালে `bun run db:push`,
# তারপর turso shell দিয়ে SQL রিস্টোর (বিস্তারিত docs/SETUP.md)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Google OAuth (ঐচ্ছিক) — সেট করলেই সাইন-ইন ডায়ালগে Google বোতাম চালু হয় ───
# https://console.cloud.google.com/apis/credentials → OAuth client ID
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── পাবলিক সাইট URL (SEO/শেয়ার লিংকের ভিত্তি; Vercel-এ NEXT_PUBLIC_SITE_URL দিন) ───
NEXT_PUBLIC_SITE_URL=
